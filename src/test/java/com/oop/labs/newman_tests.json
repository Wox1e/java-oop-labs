	"event": [
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Collection-level tests for OOP API",
					"// These will run after every request in the collection",
					"",
					"pm.test(\"Status code is 2xx\", function () {",
					"    pm.expect(pm.response.code).to.be.within(200, 299);",
					"});",
					"",
					"pm.test(\"Response has Content-Type header\", function () {",
					"    pm.response.to.have.header(\"Content-Type\");",
					"});",
					"",
					"// If response is JSON, check for common properties",
					"if (pm.response.headers.get(\"Content-Type\") && pm.response.headers.get(\"Content-Type\").includes(\"application/json\")) {",
					"    let jsonData;",
					"    try {",
					"        jsonData = pm.response.json();",
					"        pm.test(\"Response is valid JSON\", function () {",
					"            pm.expect(jsonData).to.be.an(\"object\");",
					"        });",
					"        // Check for typical keys (customize as needed)",
					"        const possibleKeys = [\"id\", \"name\", \"status\", \"message\", \"data\", \"error\"];",
					"        pm.test(\"Response contains at least one expected key\", function () {",
					"            const keys = Object.keys(jsonData);",
					"            pm.expect(keys.some(k => possibleKeys.includes(k))).to.be.true;",
					"        });",
					"    } catch (e) {",
					"        pm.test(\"Response is not valid JSON\", function () {",
					"            pm.expect.fail(\"Response body is not valid JSON\");",
					"        });",
					"    }",
					"}",
					""
				]
			}
		}
