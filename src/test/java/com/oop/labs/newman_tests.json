		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"requests": {},
				"exec": [
					"const createUserRequest = {",
					"    url: 'http://localhost:8080/users/',",
					"    method: 'POST',",
					"    header: {",
					"        'Content-Type': 'application/json'",
					"    },",
					"    body: {",
					"        mode: 'raw',",
					"        raw: JSON.stringify({",
					"            username: 'ls2',",
					"            password: '123'",
					"        })",
					"    }",
					"};",
					"",
					"// Выполняем запрос на создание пользователя",
					"pm.sendRequest(createUserRequest, function (err, response) {",
					"    if (err) {",
					"        console.error('Error creating user:', err);",
					"        return;",
					"    }",
					"    ",
					"    if (response.code === 201) {",
					"        const userData = response.json();",
					"        // Сохраняем ID пользователя для использования в тестах",
					"        pm.collectionVariables.set('user_id', userData.id);",
					"        pm.collectionVariables.set('user_email', userData.email);",
					"        console.log('User created successfully:', userData.id);",
					"    } else {",
					"        console.error('Failed to create user:', response.text());",
					"    }",
					"});"
				]
			}
		},
